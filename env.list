# Runtime environment for the serving container, passed with `docker run --env-file env.list`.
# Every path here is a path INSIDE the container; the host side is mounted by start.sh (/cache, /opt/exl3xpu).
# These are the settings the recipe was validated with. They are not knobs to tune per host.

# --- Level Zero / SYCL / oneCCL -------------------------------------------------------------------
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_ZE_IPC_EXCHANGE=sockets
UR_L0_V2_FORCE_DISABLE_COPY_OFFLOAD=1
# Level Zero peer-residency shim: ships in the runtime image (docs/runtime-image.md), no public source
LD_PRELOAD=/opt/b70-residency-shim/libl0_peer_residency_shim.so

# --- XPU graphs -----------------------------------------------------------------------------------
# Capture is enabled; EXL3_CAPTURE_GUARD=raise makes the plugin abort instead of silently falling back
VLLM_XPU_ENABLE_XPU_GRAPH=1
EXL3_CAPTURE_GUARD=raise

# --- offline weights, caches on the mounted /cache ------------------------------------------------
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/cache/hf
TMPDIR=/cache/tmp
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
XDG_CACHE_HOME=/cache/xdg

# --- thinking budget per requested effort (the chat template's reasoning_effort) ------------------
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192

# --- sampling defaults applied by the reasoning-effort plugin -------------------------------------
B70_DEFAULT_PRESENCE_PENALTY=0
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
B70_REASONING_EFFORT_ALIAS=1

# --- Gated DeltaNet: back-step through the MTP draft in one graph ---------------------------------
B70_OFFLOAD_GDN_BACKSTEP=1

# --- allocator: pinned host cache ceiling for the weight staging buffers ---------------------------
PYTORCH_ALLOC_CONF=pinned_max_cached_size_mb:1024

# --- vLLM runner ----------------------------------------------------------------------------------
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_MOE_SKIP_PADDING=1

# --- the plugin dist (start.sh mounts it at /opt/exl3xpu) ------------------------------------------
PYTHONPATH=/opt/exl3xpu
VLLM_WORKER_SHUTDOWN_TIMEOUT_SECONDS=90
