# Copy to .env and fill in. All paths are on the host.

# Weights: Mia-AiLab/Ornith-1.5-122B-EXL3-EAQv1-4-bpw at the revision this recipe was validated on (61.1 GiB):
#   hf download Mia-AiLab/Ornith-1.5-122B-EXL3-EAQv1-4-bpw --revision 9c5c913b3de1eef901520d6fedaf450044ea0423 --local-dir <MODEL_DIR>
MODEL_DIR=/path/to/Ornith-1.5-122B-EXL3-EAQv1-4-bpw

# The vLLM XPU image the plugin loads into (vLLM 0.30, torch 2.13.0+xpu). The kernels are built against ITS torch.
RUNTIME_IMAGE=your-vllm-0.30-xpu-image:tag

# Image with the oneAPI DPC++ compiler (icpx 2026.1), used only to build the kernels (CPU only, no GPU needed).
TOOLCHAIN_IMAGE=intel/omix:0.4.0-devel-ubuntu24.04

# Where the kernel build writes its outputs (relative paths are relative to this repo).
BUILD_DIR=./build

# Serving (used once the 4-card lane lands; see README "Status").
PORT=8000
SERVED_MODEL_NAME=ornith-1.5-122b-exl3
GPUS=0,1,2,3
