# Copy to .env and fill it in:  cp .env.example .env
# Every path here is on the host. Sourced by start.sh, scripts/build-kernels.sh and scripts/build-vxk.sh.

# Weights (61.04 GiB): Mia-AiLab/Ornith-1.5-122B-EXL3-EAQv1-4-bpw at the revision this recipe was validated on:
#   hf download Mia-AiLab/Ornith-1.5-122B-EXL3-EAQv1-4-bpw --revision 9c5c913b3de1eef901520d6fedaf450044ea0423 --local-dir <MODEL_DIR>
# That revision was verified against the hub (2026-10-23): the LFS oid of model-00001-of-00009.safetensors
# (4f5056002565e4ba656fd60f518bf96611e4e2ee8a1d5d0a9233f6a53f2408a9), of quantization_config.json
# (c64d1f223969baf06847b3d8488a6e28ad21c44d2b4452ae805ef2bc6ab0168a) and of model.safetensors.index.json
# (2e1052cfd5572c98dedded90049ab90be0dd1a192edd2e97e6ed407fab3a4eec) from the hub's tree API at that revision
# equal the sha256 of the local files, and config.json / generation_config.json / tokenizer_config.json are
# byte-identical to the hub's resolve/<revision>/ URLs.
MODEL_DIR=/path/to/Ornith-1.5-122B-EXL3-EAQv1-4-bpw

# The engine image, pinned by its local image ID: vLLM 0.30.0 XPU, torch 2.13.0+xpu, vllm_xpu_kernels 0.1.14.1.
# `docker run sha256:...` resolves it as long as that image is present locally. What it is, how it is built and
# which of its pieces are not publicly obtainable: docs/runtime-image.md.
RUNTIME_IMAGE=sha256:6021b4b8d99d6fa7e139dff53028356135201eb4e6479f091ce55f0f78c4307d

# Image with the oneAPI DPC++ compiler (icpx 2026.1), used only to build the kernels (CPU only, no GPU).
TOOLCHAIN_IMAGE=intel/omix:0.4.0-devel-ubuntu24.04

# Where the EXL3 kernel build (scripts/build-kernels.sh) writes its outputs. Relative paths are relative to this repo.
BUILD_DIR=./build

# Where the vllm_xpu_kernels overlay (scripts/build-vxk.sh) is built. It is mounted over the image's package.
VXK_DIR=./build/vxk

# Container name. start.sh removes an existing container of this name before starting.
CONTAINER_NAME=ornith-exl3

# Optional: how long start.sh polls /v1/models during boot, in seconds. Default 1800; raise it on a slower host.
READY_WAIT_SECONDS=1800

# Serving: the port is on the host (the container runs with --network host).
PORT=8022
SERVED_MODEL_NAME=ornith-1.5-122b-exl3

# Four card indices for ZE_AFFINITY_MASK. Tensor parallelism is fixed at 4 (2 KV heads, 32 query heads).
GPUS=0,1,2,3

# The validated operating point. start.sh refuses values above these ceilings rather than tuning them silently:
# MAX_NUM_SEQS 16, MAX_MODEL_LEN 262144 and MTP_K 2. GPU_MEM_UTIL and MAX_NUM_BATCHED_TOKENS are range-checked only
# (GPU_MEM_UTIL must be in (0,1]; MAX_NUM_BATCHED_TOKENS any positive integer).
# Memory fraction per card:
GPU_MEM_UTIL=0.85
# Concurrent sequences (<= 16; MTP k=2 needs 16 x 3 = 48 capture slots):
MAX_NUM_SEQS=16
# MTP draft tokens per step:
MTP_K=2
# Context length (<= 262144):
MAX_MODEL_LEN=262144
# Batched-token budget per step:
MAX_NUM_BATCHED_TOKENS=4096
